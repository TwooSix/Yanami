{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yanami.dev/perf/contracts/run-manifest-v1.schema.json",
  "title": "Yanami performance probe run manifest v1",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "renderingEnvironment": {
      "type": "object",
      "required": [
        "renderWidthPixels",
        "renderHeightPixels",
        "displayRefreshHz",
        "dpiScalePercent",
        "hdrEnabled",
        "vrrEnabled",
        "windowMode",
        "qtRhiRenderer",
        "fontSetId",
        "fontSetSha256",
        "fontFamilies",
        "fontCacheState",
        "fontCachePreparationId"
      ],
      "properties": {
        "renderWidthPixels": { "type": "integer", "minimum": 1 },
        "renderHeightPixels": { "type": "integer", "minimum": 1 },
        "displayRefreshHz": { "type": "number", "exclusiveMinimum": 0 },
        "dpiScalePercent": { "type": "number", "exclusiveMinimum": 0 },
        "hdrEnabled": { "type": "boolean" },
        "vrrEnabled": { "type": "boolean" },
        "windowMode": {
          "type": "string",
          "enum": ["windowed", "borderless-windowed", "borderless-fullscreen", "exclusive-fullscreen"]
        },
        "qtRhiRenderer": { "type": "string", "minLength": 1 },
        "fontSetId": { "type": "string", "minLength": 1 },
        "fontSetSha256": { "$ref": "#/$defs/sha256" },
        "fontFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fontCacheState": {
          "type": "string",
          "enum": ["cold", "warm", "reset"]
        },
        "fontCachePreparationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "externalEvidenceCollector": {
      "type": "object",
      "required": ["name", "version", "kind", "clockDomain"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "clockDomain": { "type": "string", "minLength": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["role", "fileName", "sha256"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "collector": { "$ref": "#/$defs/externalEvidenceCollector" },
        "runnerValidated": { "type": "boolean" },
        "validatedBytes": { "type": "integer", "minimum": 1 },
        "candidateSha": { "type": "string" },
        "scenarioId": { "type": "string", "minLength": 1 },
        "processId": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "profile",
    "startedAtUtc",
    "environment",
    "fixtures",
    "suites",
    "metrics",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "string",
      "enum": ["PullRequest", "Lab", "Nightly", "Weekly", "Release"]
    },
    "mode": { "type": "string", "enum": ["collect", "debt", "enforce"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "finishedAtUtc": { "type": "string", "format": "date-time" },
    "candidateSha": { "type": "string" },
    "baseSha": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["fingerprint", "referenceMatch"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "referenceMatch": { "type": "boolean" },
        "mismatchReasons": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "object", "additionalProperties": true },
        "rendering": { "$ref": "#/$defs/renderingEnvironment" }
      },
      "additionalProperties": true
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "validated"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "validated": { "type": "boolean" },
          "details": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["search", "backend", "interaction", "playback", "danmaku", "startup"]
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "unit", "samples"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number" }
          },
          "attributes": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "details": { "type": ["string", "object", "array", "null"] }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "additionalProperties": true
}
