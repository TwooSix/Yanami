        "Yu Gothic UI",
        "Segoe UI Emoji"
      ],
      "fingerprintAlgorithm": "sha256(lowercase-path-and-file-sha256-pairs-sorted-by-lowercase-path)",
      "allowedFingerprintSource": "lab fingerprint allow-list"
    },
    "fontCacheState": "warm",
    "fontCachePreparationId": "DanmakuGlyphWarmup-v1"
  },
  "upscalingStrictRendering": {
    "renderWidthPixels": 3840,
