    "llvmpipe",
    "softpipe",
    "swiftshader",
    "software rasterizer",
    "gdi generic",
    "microsoft basic render driver",
    "mesa offscreen"
  ],
  "providers": [
    { "id": "anime4k", "requiresModelPack": true }
  ],
  "presets": ["performance", "balanced", "quality"],
  "cases": [
