      "maximumTextureSize": 4096,
      "expectedSupportedProviders": ["anime4k"],
      "expectedSoftwareRenderer": false,
      "expectedUnavailableReasonContains": ""
    },
    {
      "id": "opengl46-supported",
      "graphicsApi": "OpenGL",
      "glMajor": 4,
      "glMinor": 6,
