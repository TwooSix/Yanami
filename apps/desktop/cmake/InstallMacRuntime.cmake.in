set(installed_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(installed_bundle "${installed_root}/Yanami.app")
set(installed_bridge
    "${installed_bundle}/Contents/MacOS/@YANAMI_RUST_BRIDGE_NAME@")

if(NOT IS_DIRECTORY "${installed_bundle}")
    message(FATAL_ERROR "Installed macOS bundle is missing: ${installed_bundle}")
endif()
if(NOT EXISTS "${installed_bridge}")
    message(FATAL_ERROR "Installed Rust bridge is missing: ${installed_bridge}")
endif()

# The real libmpv file is installed before the generated Qt deployment script.
# macdeployqt then deploys the Qt/QML runtime and rewrites the complete linked
# dependency graph of both the desktop executable and that bundled libmpv.
# Do not pass the relocated graph through BundleUtilities a second time:
# BundleUtilities treats valid @loader_path references as source paths and
# fails to resolve them. Verify every Mach-O reference instead.
execute_process(
    COMMAND /bin/bash
        "@YANAMI_WORKSPACE@/scripts/verify-macos-bundle.sh"
        "${installed_bundle}"
    RESULT_VARIABLE verification_result
    COMMAND_ECHO STDOUT
)
if(NOT verification_result EQUAL 0)
    message(FATAL_ERROR
        "macOS dependency verification failed with exit code ${verification_result}")
endif()

# Apple Silicon requires code objects to carry a signature. This ad-hoc
# signature provides integrity only; release candidates remain unsigned by a
# Developer ID and are intentionally not notarized.
execute_process(
    COMMAND /usr/bin/codesign --force --deep --sign - --timestamp=none
        "${installed_bundle}"
    RESULT_VARIABLE codesign_result
    COMMAND_ECHO STDOUT
)
if(NOT codesign_result EQUAL 0)
    message(FATAL_ERROR "Ad-hoc signing failed with exit code ${codesign_result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@"
        "-DYANAMI_PACKAGE_ROOT=${installed_root}"
        -P "@CMAKE_CURRENT_SOURCE_DIR@/cmake/WritePackageManifest.cmake"
    RESULT_VARIABLE manifest_result
)
if(NOT manifest_result EQUAL 0)
    message(FATAL_ERROR
        "Writing the macOS package manifest failed with exit code ${manifest_result}")
endif()
