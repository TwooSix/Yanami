#define IDI_YANAMI_INSTALLER_ICON 101

IDI_YANAMI_INSTALLER_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/windows/yanami.ico"
1 24 "@CMAKE_CURRENT_SOURCE_DIR@/installer/yanami-installer.manifest"

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Yanami contributors\0"
            VALUE "FileDescription", "Yanami Installer\0"
            VALUE "FileVersion", "@YANAMI_BUILD_VERSION@\0"
            VALUE "InternalName", "yanami-installer-stub\0"
            VALUE "LegalCopyright", "Copyright (C) Yanami contributors\0"
            VALUE "OriginalFilename", "Yanami-Installer.exe\0"
            VALUE "ProductName", "Yanami\0"
            VALUE "ProductVersion", "@YANAMI_BUILD_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
