<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Yanami Rust third-party licenses</title>
  <style>
    body { font: 15px/1.5 system-ui, sans-serif; margin: 0; color: #20242c; }
    main { max-width: 960px; margin: 0 auto; padding: 32px; }
    a { color: #8a3150; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: 16px;
      background: #f4f5f7; border-radius: 8px; }
    .license { margin: 28px 0; }
  </style>
</head>
<body>
<main>
  <h1>Yanami Rust third-party licenses</h1>
  <p>Generated from the locked Cargo dependency graph for the Windows release target.</p>
  <h2>License overview</h2>
  <ul>
  {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
  {{/each}}
  </ul>
  {{#each licenses}}
  <section class="license">
    {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
    <h3 id="{{id}}-{{@index}}">{{name}}</h3>
    <p>Used by:</p>
    <ul>
    {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
    {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</main>
</body>
</html>
